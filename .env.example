DATABASE_URL=postgresql://blog:change-me@postgres:5432/blog
POSTGRES_DB=blog
POSTGRES_USER=blog
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379
JOB_SECRET=replace-with-a-long-random-secret
AUTH_SECRET=replace-with-another-long-random-secret
AUTH_TRUST_HOST=true
# 公网访问 origin（协议+域名[+端口]），用于 Auth.js 构造登录/登出等绝对重定向。
# 不设会退化成从请求推断，容器内可能泄漏成 http://0.0.0.0:3000。
# 本地 docker 发布在 80 端口：http://localhost；上云带域名后改成 https://your-domain.com
AUTH_URL=http://localhost
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
PUBLIC_REGISTRATION_ENABLED=false
COMMENTS_ENABLED=false
STAFF_MFA_ENFORCED=false
# Generate independently with: openssl rand -base64 32
MFA_SECRET_KEY=replace-with-base64-encoded-32-byte-key
SUBSCRIPTIONS_ENABLED=false
# Generate with: openssl rand -base64 32
SUBSCRIBE_TOKEN_SECRET=replace-with-base64-encoded-32-byte-key
MAIL_OUTBOX_KEY=replace-with-base64-encoded-32-byte-key
MAIL_PROVIDER=smtp
# Tencent Cloud SES API (production: MAIL_PROVIDER=tencent_api)
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
# SendEmail currently supports ap-guangzhou or ap-hongkong.
TENCENT_SES_REGION=ap-guangzhou
MAIL_FROM_ADDRESS=noreply@mail.xiudou.site
MAIL_FROM_NAME=边界笔记
MAIL_REPLY_TO=
SES_TEMPLATE_VERIFY_EMAIL=
SES_TEMPLATE_SUBSCRIBE_CONFIRM=
SES_TEMPLATE_POST_PUBLISHED=
SES_TEMPLATE_PASSWORD_RESET=
SES_TEMPLATE_SECURITY_ALERT=
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASSWORD=replace-me
SMTP_FROM=blog@example.com
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
NEXT_PUBLIC_SITE_URL=http://localhost
NEXT_PUBLIC_SITE_NAME=边界笔记
NEXT_PUBLIC_COPYRIGHT_YEAR=2026
NEXT_PUBLIC_ICP_BEIAN=
# 公安联网备案通过后填写完整展示文字，例如：津公网安备 12000000000000号
NEXT_PUBLIC_MPS_BEIAN=
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_GITHUB_URL=
UPLOADS_DIR=./uploads
